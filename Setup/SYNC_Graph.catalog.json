    "installer": {
      "source": {
        "type": "githubRelease",
        "owner": "vramwiz",
        "repo": "SYNC_Graph",
        "pattern": "^SYNC_Graph\\.zip$",
        "github": {
          "owner": "vramwiz",
          "repo": "SYNC_Graph",
